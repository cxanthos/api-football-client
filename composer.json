{
    "name": "cxanthos/api-football-client",
    "description": "Typed PHP SDK for API-Football v3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Christos Xanthos"
        }
    ],
    "require": {
        "php": "^8.4 || ^8.5",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0 || ^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.59",
        "guzzlehttp/guzzle": "^8.0",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "ApiFootball\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApiFootball\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
